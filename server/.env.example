# ──────────────────────────────────────────────
# LibroYa — Variables de entorno del servidor
# Copia este archivo a .env y completa los valores
# ──────────────────────────────────────────────

# MongoDB Atlas
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS — URL exacta del frontend (sin barra final)
CLIENT_ORIGIN=http://localhost:3000

# Puerto del servidor
PORT=4000

# PayPal Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

